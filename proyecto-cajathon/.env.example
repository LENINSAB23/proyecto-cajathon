# CAJA INTELIGENTE - Variables de entorno

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=

# OpenAI (opcional; DEMO_MODE=True fuerza el motor heurístico)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Dashboard > Connect > Session pooler URI (for Render).
# Keep URL-encoding for special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# SQLite local (used only when DATABASE_URL is unset outside production)
SQLITE_DB_PATH=database/caja_inteligente.db

# Obligatorio con DATABASE_URL o en producción; crea la cuenta administradora inicial
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# En desarrollo activa datos y accesos de demostración
DEMO_MODE=True

# Parámetros financieros SBS / CMAC
TASA_INTERES_MENSUAL_REF=0.028
DTI_UMBRAL_BAJO=35.0
DTI_UMBRAL_MEDIO=50.0
