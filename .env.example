# Configuración local de CAJA INTELIGENTE
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-only-cambia-esta-clave-antes-de-desplegar

# Para desarrollo local, deja DEMO_MODE=True y usa SQLite con datos ficticios.
DEMO_MODE=True
DEMO_LOGIN_ENABLED=True

# Supabase Auth + PostgreSQL (necesarios en producción).
# Copia los valores desde Supabase > Project Settings.
SUPABASE_URL=
SUPABASE_KEY=
# Copia la URI de PostgreSQL desde Supabase > Project Settings > Database.
# Usa el pooler de sesión si Render no tiene conectividad IPv6.
DATABASE_URL=

# Bank-ito IA (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Telegram Bot API (Alertas automáticas de riesgo alto)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: si no se define, se usa el motor heurístico local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram es opcional; usa solo variables de entorno, nunca código fuente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Parámetros SBS / CMAC
TASA_INTERES_MENSUAL_REF=0.028
DTI_UMBRAL_BAJO=35.0
DTI_UMBRAL_MEDIO=50.0
HEALTH_MORA_WARNING=5.0
HEALTH_MORA_CRITICAL=10.0
GEO_MORA_MEDIUM=8.0
GEO_MORA_HIGH=20.0
