# ========================================================
# CAJA INTELIGENTE - Variables de Entorno (Ejemplo)
# ========================================================

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=clave-secreta-caja-inteligente-senati-2026-cambiar-en-produccion

# Supabase (PostgreSQL & Auth)
# Obtén estos valores en tu consola de Supabase: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anonima-publica-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-supabase
# URL de conexión directa PostgreSQL (opcional para SQLAlchemy/psycopg2)
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# OpenAI API
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui
OPENAI_MODEL=gpt-4o-mini

# Modo Demostración
# Si se activa (True), el sistema utiliza el motor de IA local heurístico y base de datos local
# para permitir pruebas completas aún sin claves de OpenAI o Supabase configuradas.
DEMO_MODE=True

# Parámetros Financieros (SBS - CMAC Perú)
TASA_INTERES_MENSUAL_REF=0.028
DTI_UMBRAL_BAJO=35.0
DTI_UMBRAL_MEDIO=50.0
